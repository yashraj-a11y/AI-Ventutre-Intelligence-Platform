{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Venture Intelligence Platform API",
    "description": "Production backend over Architecture V1.0 (Days 1-13). Deterministic, honesty-tiered outputs; requests accept real Kickstarter campaign fields only.",
    "version": "1.0.0"
  },
  "paths": {
