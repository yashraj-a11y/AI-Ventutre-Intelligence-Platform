        ],
        "summary": "Retrieve",
        "operationId": "retrieve_retrieve_post",
        "parameters": [
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 1,
              "default": 5,
              "title": "K"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
