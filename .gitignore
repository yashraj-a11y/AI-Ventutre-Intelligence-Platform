# Day-18 real environment file (never commit; use .env.example)
.env

# Day-18 runtime logs (never commit)
logs/

# Day-19 frontend build outputs
frontend/node_modules/
frontend/dist/
frontend/.vite/

# NLTK corpora downloaded at deploy time (render.yaml sets NLTK_DATA here)
nltk_data/
