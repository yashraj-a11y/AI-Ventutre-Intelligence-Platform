# Day 18 · Phase D — deployment environment (copy to `.env`, edit, keep `.env` out of git).
#
# These are DEPLOYMENT settings, read by src/utils/config.deployment_settings(). They are separate from
# the ML config in configs/preprocessing.yaml. Every value has a safe default, so `.env` is optional.
#
# 🔴 There are NO secrets/API keys here — the platform is deterministic with no external services
#    (no LLM, no third-party APIs). Do not add fabricated secrets; there is nothing to protect.

# --- server ---
PORT=8000                     # host port the API listens on
WORKERS=1                     # uvicorn workers. Each loads the full ~1 GB warm stack — scale by
                              # adding CONTAINERS, not workers.

# --- logging ---
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/application.log # file sink for logs (empty = console only)

# --- deployment mode ---
DEPLOY_MODE=production        # development | staging | production

# --- artifact + data locations (mounted as volumes in docker-compose) ---
ARTIFACTS_DIR=artifacts       # trained models, FAISS index, embeddings (read-only mount)
DATA_DIR=data                 # processed dataset (read-only mount)

# --- CORS (Phase I) ---
# Comma-separated allowed origins for the browser frontend (Day 19). Empty = no cross-origin access.
CORS_ORIGINS=

# --- optional side-car ports (docker-compose profiles) ---
HTTP_PORT=80                  # nginx (profile: proxy)
MLFLOW_PORT=5000              # mlflow ui (profile: dev)
